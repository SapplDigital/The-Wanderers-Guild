position = Vector3(-7.60, 0.00, 5.00)
script = ExtResource("interactable")
verb = "Read"
prompt_height = 2.2
state_id = "notice_board"
message = "Most notices are years old. One is fresh, pinned with a fishhook: 'LIGHTS IN THE OLD WOOD. DO NOT FOLLOW THEM.'"
message_repeat = "'DO NOT FOLLOW THEM.' Someone has added, in smaller letters: 'we mean it'."
condition_flag = "quest.missing_ring.kept"
condition_message = "A new notice, in careful letters: 'LOST: a plain gold ring, scratched like a little river. Please. - Hollis'"

