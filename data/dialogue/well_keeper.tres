[sub_resource type="Resource" id="nd64"]
script = ExtResource("node")
id = &"glow"
speaker = "Wenna"
text = "Teal, ever since the old shrine woke. Something small swims down there in circles. I've named it Pim."

[sub_resource type="Resource" id="cs65"]
script = ExtResource("cons")
kind = 0
key = "quest.missing_ring.knows_hoard"

[sub_resource type="Resource" id="ch66"]
script = ExtResource("choice")
text = "Could I get it back without a fight?"
consequences = Array[ExtResource("cons")]([SubResource("cs65")])
next = &"midge_trade"

[sub_resource type="Resource" id="cs67"]
script = ExtResource("cons")
kind = 0
key = "quest.missing_ring.knows_hoard"

[sub_resource type="Resource" id="ch68"]
script = ExtResource("choice")
text = "Then I'll go and take it back."
consequences = Array[ExtResource("cons")]([SubResource("cs67")])

[sub_resource type="Resource" id="nd69"]
script = ExtResource("node")
id = &"ring_midges"
speaker = "Wenna"
text = "A ring? The Glimmer Midges carry off anything that shines. They pile it up among the stones at the forest edge."
choices = Array[ExtResource("choice")]([SubResource("ch66"), SubResource("ch68")])

[sub_resource type="Resource" id="cs70"]
script = ExtResource("cons")
kind = 0
key = "quest.missing_ring.has_glint_stone"

[sub_resource type="Resource" id="cs71"]
script = ExtResource("cons")
kind = 0
key = "quest.missing_ring.knows_hoard"

[sub_resource type="Resource" id="ch72"]
script = ExtResource("choice")
text = "Take the glint stone."
consequences = Array[ExtResource("cons")]([SubResource("cs70"), SubResource("cs71")])

[sub_resource type="Resource" id="cs73"]
script = ExtResource("cons")
kind = 0
key = "quest.missing_ring.knows_hoard"

[sub_resource type="Resource" id="ch74"]
script = ExtResource("choice")
text = "Keep it. I'll manage."
consequences = Array[ExtResource("cons")]([SubResource("cs73")])

[sub_resource type="Resource" id="nd75"]
script = ExtResource("node")
id = &"midge_trade"
speaker = "Wenna"
text = "They're traders more than thieves. Offer them something that glints brighter and they'll swap. Here: a stone from the bottom of the well. It's been shining since the lights came."
choices = Array[ExtResource("choice")]([SubResource("ch72"), SubResource("ch74")])

[sub_resource type="Resource" id="nd76"]
script = ExtResource("node")
id = &"kept_remark"
speaker = "Wenna"
text = "Hollis has pinned a notice about a lost ring. You wouldn't know anything about that, would you?"

