[sub_resource type="Resource" id="ch22"]
script = ExtResource("choice")
text = "Goodbye."

[sub_resource type="Resource" id="nd23"]
script = ExtResource("node")
id = &"first"
speaker = "Wenna"
text = "A new face. Mind the water, traveller. It's been answering back."
choices = Array[ExtResource("choice")]([SubResource("ch11"), SubResource("ch13"), SubResource("ch17"), SubResource("ch21"), SubResource("ch22")])

[sub_resource type="Resource" id="cs24"]
script = ExtResource("cons")
kind = 1
key = "rumour.old_wood_lights"

[sub_resource type="Resource" id="cs25"]
script = ExtResource("cons")
kind = 0
key = "npc.well_keeper.told_lights"

[sub_resource type="Resource" id="ch26"]
script = ExtResource("choice")
text = "What lights?"
consequences = Array[ExtResource("cons")]([SubResource("cs24"), SubResource("cs25")])
next = &"lights"

[sub_resource type="Resource" id="ch27"]
script = ExtResource("choice")
text = "I'll keep an eye on it."

[sub_resource type="Resource" id="nd28"]
script = ExtResource("node")
id = &"reflection"
speaker = "Wenna"
text = "Your face shows up a moment late. Mine too, ever since the lights started in the old wood. Nobody else seems bothered."
choices = Array[ExtResource("choice")]([SubResource("ch26"), SubResource("ch27")])

[sub_resource type="Resource" id="nd29"]
script = ExtResource("node")
id = &"lights"
speaker = "Wenna"
text = "Blue ones, low between the trees north of the clearing. The notice board says don't follow them. The notice board says a lot of things."

[sub_resource type="Resource" id="cd30"]
script = ExtResource("cond")
flag = "world.well_lamp_lit"
test = 1

[sub_resource type="Resource" id="cs31"]
script = ExtResource("cons")
kind = 0
key = "world.well_lamp_lit"

[sub_resource type="Resource" id="ch32"]
