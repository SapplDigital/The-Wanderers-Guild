[sub_resource type="Resource" id="nd90"]
script = ExtResource("node")
id = &"lamp_thanks"
speaker = "Wenna"
text = "The lamp's still burning. I sleep better for it."
choices = Array[ExtResource("choice")]([SubResource("ch70"), SubResource("ch73"), SubResource("ch76"), SubResource("ch79"), SubResource("ch83"), SubResource("ch87"), SubResource("ch110"), SubResource("ch88"), SubResource("ch89")])

[sub_resource type="Resource" id="nd91"]
script = ExtResource("node")
id = &"glow"
speaker = "Wenna"
text = "Teal, ever since the old shrine woke. Something small swims down there in circles. I've named it Pim."

[sub_resource type="Resource" id="nd92"]
script = ExtResource("node")
id = &"fish_magical_leak"
speaker = "Wenna"
text = "Glowing, aren't they? The water's gone fizzy with something, tastes like a thunderstorm. I'd not keep them in there. The pond's bigger than my well."

[sub_resource type="Resource" id="nd93"]
script = ExtResource("node")
id = &"fish_sleeping_spirit"
speaker = "Wenna"
text = "One of them looked at me like it knew my name. Something old is dreaming down there, and these are its dreams getting out. They want more room. The pond, maybe."

[sub_resource type="Resource" id="nd94"]
script = ExtResource("node")
id = &"fish_world_anomaly"
speaker = "Wenna"
text = "Pim has friends now. They swim in circles the wrong way round, and none of them casts a shadow. Whatever woke up in that shrine reaches all the way down here."

[sub_resource type="Resource" id="cs95"]
script = ExtResource("cons")
kind = 0
key = "quest.missing_ring.knows_hoard"

[sub_resource type="Resource" id="ch96"]
script = ExtResource("choice")
text = "Could I get it back without a fight?"
consequences = Array[ExtResource("cons")]([SubResource("cs95")])
next = &"midge_trade"

[sub_resource type="Resource" id="cs97"]
script = ExtResource("cons")
kind = 0
key = "quest.missing_ring.knows_hoard"

[sub_resource type="Resource" id="ch98"]
script = ExtResource("choice")
text = "Then I'll go and take it back."
consequences = Array[ExtResource("cons")]([SubResource("cs97")])

[sub_resource type="Resource" id="nd99"]
script = ExtResource("node")
id = &"ring_midges"
speaker = "Wenna"
text = "A ring? The Glimmer Midges carry off anything that shines. They pile it up among the stones at the forest edge."
choices = Array[ExtResource("choice")]([SubResource("ch96"), SubResource("ch98")])

[sub_resource type="Resource" id="cs100"]
script = ExtResource("cons")
kind = 0
key = "quest.missing_ring.has_glint_stone"

[sub_resource type="Resource" id="cs101"]
script = ExtResource("cons")
kind = 0
key = "quest.missing_ring.knows_hoard"

[sub_resource type="Resource" id="ch102"]
script = ExtResource("choice")
text = "Take the glint stone."
consequences = Array[ExtResource("cons")]([SubResource("cs100"), SubResource("cs101")])

[sub_resource type="Resource" id="cs103"]
script = ExtResource("cons")
kind = 0
key = "quest.missing_ring.knows_hoard"

[sub_resource type="Resource" id="ch104"]
script = ExtResource("choice")
text = "Keep it. I'll manage."
consequences = Array[ExtResource("cons")]([SubResource("cs103")])

[sub_resource type="Resource" id="nd105"]
script = ExtResource("node")
id = &"midge_trade"
speaker = "Wenna"
text = "They're traders more than thieves. Offer them something that glints brighter and they'll swap. Here: a stone from the bottom of the well. It's been shining since the lights came."
choices = Array[ExtResource("choice")]([SubResource("ch102"), SubResource("ch104")])

[sub_resource type="Resource" id="nd106"]
script = ExtResource("node")
id = &"kept_remark"
speaker = "Wenna"
text = "Hollis has pinned a notice about a lost ring. You wouldn't know anything about that, would you?"

[resource]
script = ExtResource("data")
id = &"well_keeper"
entries = Array[ExtResource("choice")]([SubResource("ch3"), SubResource("ch7"), SubResource("ch9"), SubResource("ch10")])
nodes = Array[ExtResource("node")]([SubResource("nd32"), SubResource("nd37"), SubResource("nd38"), SubResource("nd43"), SubResource("nd44"), SubResource("nd68"), SubResource("nd90"), SubResource("nd91"), SubResource("nd92"), SubResource("nd93"), SubResource("nd94"), SubResource("nd99"), SubResource("nd105"), SubResource("nd106"), SubResource("nd111")])
