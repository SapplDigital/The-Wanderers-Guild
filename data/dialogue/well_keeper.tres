[sub_resource type="Resource" id="nd111"]
script = ExtResource("node")
id = &"ember"
speaker = "Wenna"
text = "Somebody's finally lighting that place? Here, from my stove, banked in ash. Keep it out of the wet and it'll last till you're home."

[sub_resource type="Resource" id="nd32"]
script = ExtResource("node")
id = &"first"
speaker = "Wenna"
text = "A new face. Mind the water, traveller. It's been answering back."
choices = Array[ExtResource("choice")]([SubResource("ch11"), SubResource("ch13"), SubResource("ch16"), SubResource("ch19"), SubResource("ch22"), SubResource("ch26"), SubResource("ch30"), SubResource("ch110"), SubResource("ch31")])

[sub_resource type="Resource" id="cs33"]
script = ExtResource("cons")
kind = 1
key = "rumour.old_wood_lights"

[sub_resource type="Resource" id="cs34"]
script = ExtResource("cons")
kind = 0
key = "npc.well_keeper.told_lights"

[sub_resource type="Resource" id="ch35"]
script = ExtResource("choice")
text = "What lights?"
consequences = Array[ExtResource("cons")]([SubResource("cs33"), SubResource("cs34")])
next = &"lights"

[sub_resource type="Resource" id="ch36"]
script = ExtResource("choice")
text = "I'll keep an eye on it."

[sub_resource type="Resource" id="nd37"]
script = ExtResource("node")
id = &"reflection"
speaker = "Wenna"
text = "Your face shows up a moment late. Mine too, ever since the lights started in the old wood. Nobody else seems bothered."
choices = Array[ExtResource("choice")]([SubResource("ch35"), SubResource("ch36")])

[sub_resource type="Resource" id="nd38"]
script = ExtResource("node")
id = &"lights"
speaker = "Wenna"
text = "Blue ones, low between the trees north of the clearing. The notice board says don't follow them. The notice board says a lot of things."

[sub_resource type="Resource" id="cd39"]
script = ExtResource("cond")
flag = "world.well_lamp_lit"
test = 1

[sub_resource type="Resource" id="cs40"]
script = ExtResource("cons")
kind = 0
key = "world.well_lamp_lit"

[sub_resource type="Resource" id="ch41"]
script = ExtResource("choice")
text = "Light it from my lantern."
conditions = Array[ExtResource("cond")]([SubResource("cd39")])
consequences = Array[ExtResource("cons")]([SubResource("cs40")])
next = &"lamp_lit"

[sub_resource type="Resource" id="ch42"]
script = ExtResource("choice")
text = "Not now."

[sub_resource type="Resource" id="nd43"]
script = ExtResource("node")
id = &"lamp"
speaker = "Wenna"
text = "Wind took the flame three nights back, and I've no oil to spare. Folk draw water in the dark now."
choices = Array[ExtResource("choice")]([SubResource("ch41"), SubResource("ch42")])

[sub_resource type="Resource" id="nd44"]
script = ExtResource("node")
id = &"lamp_lit"
speaker = "Wenna"
text = "...There. Warm again. The water looks less like it's watching."

